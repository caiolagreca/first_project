{
	"name": "first_project",
	"version": "1.0.0",
	"description": "First Project",
	"main": "index.js",
	"scripts": {
		"test": "echo \"Error: no test specified\" && exit 1",
		"start": "tsc && node ./dist/index.js",
		"start:dev": "concurrently \"tsc --watch\" \"nodemon ./dist/index.js\"",
		"swagger:generate": "tsc && node ./dist/scripts/generate-swagger.js",
		"build": "tsc && npm run copy:assets",
		"clean": "rm -rf dist",
		"copy:assets": "cpx \"src/**/*.{html,css,js,json,png,jpg,jpeg,gif,svg,ico,env}\" dist && cpx \"src/client/**/*\" dist/client"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/caiolagreca/first_project.git"
	},
