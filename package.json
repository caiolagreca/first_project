	"type": "commonjs",
	"bugs": {
		"url": "https://github.com/caiolagreca/first_project/issues"
	},
	"homepage": "https://github.com/caiolagreca/first_project#readme",
	"devDependencies": {
		"@types/express": "^5.0.6",
		"@types/node": "^25.0.6",
		"@types/swagger-jsdoc": "^6.0.4",
		"@types/swagger-ui-express": "^4.1.8",
		"concurrently": "^9.2.1",
		"cpx": "^1.5.0",
		"nodemon": "^3.1.11",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@googlemaps/places": "^2.2.0",
		"axios": "^1.13.5",
		"body-parser": "^2.2.2",
		"dotenv": "^17.2.3",
		"express": "^5.2.1",
		"google": "^2.1.0",
		"mongodb": "^7.0.0",
		"mongoose": "^9.1.3",
		"stripe": "^20.3.1",
		"swagger-jsdoc": "^6.2.8",
		"swagger-ui-express": "^5.0.1"
	}
}
